# ── Server ───────────────────────────────────────────────────────
PORT=5030

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated allowed origins (leave empty to block all in production)
CORS_ORIGIN=http://localhost:3000

# ── Authentication ───────────────────────────────────────────────
AUTH_ENABLED=false
JWT_SECRET=

# ── Encryption ───────────────────────────────────────────────────
ENCRYPTION_ENABLED=false
ENCRYPTION_SECRET=
ENCRYPTION_SALT=

# ── Rate Limiting ────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=1000
RATE_LIMIT_MAX_EVENTS=50

# ── Messages ─────────────────────────────────────────────────────
MAX_MESSAGE_SIZE=4096

# ── Logging ──────────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL=info
